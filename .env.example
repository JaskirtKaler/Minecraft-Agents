# Copy this file to .env. Do not commit .env or any API key.
#
# Local development: Ollama exposes an OpenAI-compatible API at /v1. The
# controller requires a non-empty value for NEBIUS_API_KEY even when Ollama
# ignores it, so this placeholder is intentional and is not a real credential.
NEBIUS_API_KEY=local-ollama-placeholder-not-a-secret
NEBIUS_BASE_URL=http://localhost:11434/v1
NEBIUS_MODEL=gemma4:26b

# Local Minecraft knowledge/recipe advisor (Ollama native API).
JARVIS_ENDPOINT=http://localhost:11434/api/chat
JARVIS_MODEL=gemma4:26b

# Optional web retrieval. Keep disabled unless a valid Tavily key is supplied.
ENABLE_TAVILY=false
TAVILY_API_KEY=your-optional-tavily-api-key

# Python controller WebSocket server.
WS_HOST=0.0.0.0
WS_PORT=8765

# Mineflayer bot and local Purpur server.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=AI_Agent
MC_VERSION=1.20.1
WS_URL=ws://localhost:8765

# Optional first-person viewer served by the Node bot.
ENABLE_VIEWER=false
VIEWER_PORT=3000

# Controller execution settings.
MAX_RETRIES=3
CODE_TIMEOUT_MS=30000

# Nebius production preset: replace the three local LLM values above with
# values issued for your Token Factory project. Never commit the real key.
# NEBIUS_API_KEY=your-nebius-token-factory-api-key
# NEBIUS_BASE_URL=https://api.nebius.ai/v1
# NEBIUS_MODEL=your-nvidia-open-source-model-id
