# Copy this file to .env. Do not commit .env or any API key.
#
# Local development: Ollama exposes an OpenAI-compatible API at /v1. The
# controller requires a non-empty value for NEBIUS_API_KEY even when Ollama
# ignores it, so this placeholder is intentional and is not a real credential.
NEBIUS_API_KEY=local-ollama-placeholder-not-a-secret
NEBIUS_BASE_URL=http://localhost:11434/v1
NEBIUS_MODEL=gemma4:26b

# Local Minecraft knowledge/recipe advisor (Ollama native API).
JARVIS_ENDPOINT=http://localhost:11434/api/chat
JARVIS_MODEL=gemma4:26b

# Optional web retrieval. Keep disabled unless a valid Tavily key is supplied.
ENABLE_TAVILY=false
TAVILY_API_KEY=your-optional-tavily-api-key

# Python controller WebSocket server.
WS_HOST=0.0.0.0
WS_PORT=8765

# Mineflayer bot and local Purpur server.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=AI_Agent
MC_VERSION=1.20.1
# Peaceful + no hunger for early development; does NOT enable Creative.
# To train hunger/combat later, set false, restart, and /difficulty normal.
MC_TRAINING_MODE=true
# Keep this stable across rejoins. CHANGE it when you reset/replace the world.
# Without a value, the namespace defaults to MC_HOST:MC_PORT.
MC_WORLD_ID=local-survival-v1
WS_URL=ws://localhost:8765

# Optional first-person viewer served by the Node bot.
ENABLE_VIEWER=false
VIEWER_PORT=3000

# Controller execution settings.
MAX_RETRIES=3
CODE_TIMEOUT_MS=30000
# Generated JavaScript is experimental, not a security sandbox. Disabled by
# default; game chat uses documented tools, not generated JavaScript.
ALLOW_EXPERIMENTAL_CODE=false

# Model chooses actions and decomposes tasks. "baseline" keeps the old parser for regression testing.
TASK_PLANNER=model
MODEL_STEP_TIMEOUT=120
AGENT_MAX_STEPS=20
AGENT_TIMEOUT=600
PLANNER_MAX_TOKENS=1536
AGENT_BATCH_SIZE=4
AGENT_MAX_PLAN_ERRORS=3
AGENT_REFLECTION_DELAY=10
LEARNING_DIR=data/learning
# Short structured decisions by default. Enable extended local thinking for
# harder objectives (and increase PLANNER_MAX_TOKENS) if needed; it is slower.
# Hosted model reasoning defaults are unchanged.
LOCAL_PLANNER_THINKING=false

# Persistent world checkpoints and Graphiti: all inference stays local.
MEMORY_ENABLED=true
MEMORY_DIR=data/memory
GRAPHITI_ENABLED=true
MEMORY_BASE_URL=http://localhost:11434/v1
MEMORY_API_KEY=local-ollama
MEMORY_MODEL=gemma4:26b
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBEDDING_DIM=768
MEMORY_INGEST_TIMEOUT=180

# Nebius production preset: replace the three local LLM values above with
# values issued for your Token Factory project. Never commit the real key.
# NEBIUS_API_KEY=your-nebius-token-factory-api-key
# NEBIUS_BASE_URL=https://api.nebius.ai/v1
# NEBIUS_MODEL=your-nvidia-open-source-model-id
