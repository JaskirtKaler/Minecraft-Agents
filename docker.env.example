# Copy to docker.env and edit on the joining computer. Keep docker.env private.
# The Mac's current LAN address; use its printed address if this changes.
MC_HOST=192.168.50.63
MC_PORT=25565
MC_USERNAME=AI_Agent_2
MC_VERSION=1.20.1
MC_WORLD_ID=localhost:25565
MC_COMMAND_PLAYERS=Pilot6117

# External OpenAI-compatible model API. This is an example port, not a model preset.
# host.docker.internal reaches the Windows/Mac computer running Docker Desktop.
# For a model on another LAN computer, replace that hostname with its LAN IP.
NEBIUS_BASE_URL=http://host.docker.internal:8000/v1
NEBIUS_MODEL=replace-with-your-model-id
NEBIUS_API_KEY=local-model-placeholder
TASK_PLANNER=model
ENABLE_TAVILY=false

# Legacy baseline planner's optional advisor uses Ollama's native API.
# Normal model-led planning uses NEBIUS_BASE_URL above.
JARVIS_ENDPOINT=http://host.docker.internal:11434/api/chat
JARVIS_MODEL=replace-with-your-ollama-model-id

# Exact world checkpoints and experience are always stored in the named volume.
# Optional Graphiti graph extraction also requires a working model + embedding API.
GRAPHITI_ENABLED=false
MEMORY_BASE_URL=http://host.docker.internal:8000/v1
MEMORY_API_KEY=local-model-placeholder
MEMORY_MODEL=replace-with-your-model-id
MEMORY_EMBEDDING_MODEL=replace-with-your-embedding-model-id
MEMORY_EMBEDDING_DIM=768
LOCAL_PLANNER_THINKING=false
